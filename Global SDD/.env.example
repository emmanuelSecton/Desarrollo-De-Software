# Variables de entorno de la instancia (copiar a .env; .env NO se commitea).
# Fuente: knowledge-base/08_arquitectura_propuesta.md, "Variables de entorno".
# [SENSIBLE] = secreto: se deja vacio aqui y se carga en el entorno real.
# Los valores de ejemplo no sensibles son ficticios.

# --- Usadas desde C-01 ---------------------------------------------------------

# JDBC de PostgreSQL. Con docker compose del repo el host es el servicio "postgres".
DB_URL=jdbc:postgresql://postgres:5432/consultorio
# [SENSIBLE] Credenciales del rol runtime de la app (nunca el dueno ni "postgres").
# En el despliegue del repo coinciden con APP_DB_USER / APP_DB_PASSWORD.
DB_USER=
DB_PASSWORD=
# Tamano maximo del pool Hikari por instancia (<= 5, 08 "Despliegue por instancia").
DB_POOL_MAX_SIZE=5
# URL publica de la instancia.
APP_BASE_URL=http://localhost:8080
# Zona horaria del consultorio (las fechas se guardan en UTC).
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Docker Compose (deploy/docker-compose.yml): base de la instancia -----------

# [SENSIBLE] Superusuario del contenedor PostgreSQL (solo lo usa el script de inicializacion).
POSTGRES_PASSWORD=
# Base y roles de la instancia que crea deploy/postgres/init/01-base-consultorio.sh.
# app_migrator es el dueno de la base y el unico que ejecuta Flyway/DDL.
APP_DB_NAME=consultorio
APP_DB_MIGRATOR_USER=app_migrator
# [SENSIBLE] Password del rol migrator ( Flyway ); dejado vacio aqui.
APP_DB_MIGRATOR_PASSWORD=
# app_runtime es el rol con el que corre la aplicacion: solo SELECT/INSERT y USAGE de secuencia.
# APP_DB_USER es ademas el placeholder ${runtime_role} de V2__auditoria.sql: el servicio
# "migrate" lo pasa como FLYWAY_PLACEHOLDERS_RUNTIME_ROLE al ejecutar las migraciones.
# APP_DB_USER y APP_DB_PASSWORD deben coincidir con DB_USER y DB_PASSWORD.
APP_DB_USER=app_runtime
# [SENSIBLE] Password del rol runtime; dejado vacio aqui.
APP_DB_PASSWORD=
# SPRING_FLYWAY_ENABLED=false se fija unicamente en deploy/docker-compose.yml para la app:
# no se define aqui porque los tests dependen de Flyway a nivel de aplicacion.

# --- Usadas por changes futuros --------------------------------------------------

# Usada desde C-03: email del odontologo en la instalacion.
ADMIN_INITIAL_EMAIL=
# [SENSIBLE] Usada desde C-15: verificacion inicial del webhook de WhatsApp.
WA_VERIFY_TOKEN=
# Usada desde C-19: remitente del email.
MAIL_FROM=turnos@ejemplo.com.ar
# Usadas desde C-19: envio de email por SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# [SENSIBLE]
SMTP_PASSWORD=
# [SENSIBLE] Usada desde C-14: clave AES para cifrar tokens (credenciales de WhatsApp, DD-12, y Google).
CRYPTO_KEY=
# [SENSIBLE] Usadas post-MVP (C-30, DD-13): OAuth de Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Identidad (C-03) ---
# Odontologo inicial: solo se usan si la instancia no tiene odontologo; la clave es temporal y se cambia en el primer login.
ADMIN_INITIAL_EMAIL=
# [SENSIBLE] Clave temporal del odontologo inicial; dejada vacia aqui.
ADMIN_INITIAL_PASSWORD=
# Cupos por IP y por minuto del login y de las rutas publicas.
RATE_LIMIT_LOGIN_POR_MINUTO=10
RATE_LIMIT_PUBLICO_POR_MINUTO=60

# --- Pacientes (C-09) ---
# Version de la politica de privacidad que se registra con el consentimiento de cada paciente.
POLITICA_PRIVACIDAD_VERSION=v0-provisoria
