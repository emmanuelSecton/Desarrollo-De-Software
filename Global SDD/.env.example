# Variables de entorno de la instancia (copiar a .env; .env NO se commitea).
# Fuente: knowledge-base/08_arquitectura_propuesta.md, "Variables de entorno".
# [SENSIBLE] = secreto: se deja vacio aqui y se carga en el entorno real.
# Los valores de ejemplo no sensibles son ficticios.

# --- Usadas desde C-01 ---------------------------------------------------------

# JDBC de PostgreSQL. Con docker compose del repo el host es el servicio "postgres".
DB_URL=jdbc:postgresql://postgres:5432/consultorio
# [SENSIBLE] Credenciales de la app (usuario dueno de la base del consultorio, nunca "postgres").
DB_USER=
DB_PASSWORD=
# Tamano maximo del pool Hikari por instancia (<= 5, 08 "Despliegue por instancia").
DB_POOL_MAX_SIZE=5
# URL publica de la instancia.
APP_BASE_URL=http://localhost:8080
# Zona horaria del consultorio (las fechas se guardan en UTC).
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Docker Compose (deploy/docker-compose.yml): base de la instancia -----------

# [SENSIBLE] Superusuario del contenedor PostgreSQL (solo lo usa el script de inicializacion).
POSTGRES_PASSWORD=
# Base y usuario de la instancia que crea deploy/postgres/init/01-base-consultorio.sh.
# APP_DB_USER y APP_DB_PASSWORD deben coincidir con DB_USER y DB_PASSWORD.
APP_DB_NAME=consultorio
APP_DB_USER=
# [SENSIBLE]
APP_DB_PASSWORD=

# --- Usadas por changes futuros --------------------------------------------------

# Usada desde C-03: email del odontologo en la instalacion.
ADMIN_INITIAL_EMAIL=
# [SENSIBLE] Usada desde C-15: verificacion inicial del webhook de WhatsApp.
WA_VERIFY_TOKEN=
# Usada desde C-19: remitente del email.
MAIL_FROM=turnos@ejemplo.com.ar
# Usadas desde C-19: envio de email por SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# [SENSIBLE]
SMTP_PASSWORD=
# [SENSIBLE] Usada desde C-14: clave AES para cifrar tokens (credenciales de WhatsApp, DD-12, y Google).
CRYPTO_KEY=
# [SENSIBLE] Usadas post-MVP (C-30, DD-13): OAuth de Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
